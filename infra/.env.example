# Copy to infra/.env (ignored by git). Configure only on the target server.
# Secrets below are EMPTY on purpose. Do not use this file as production values.
DOMAIN=shop.example.by
ACME_EMAIL=admin@example.by
APP_IMAGE=veshi:1.2.0
POSTGRES_PASSWORD=
NODE_ENV=production
APP_MODE=production
APP_ORIGIN=https://shop.example.by
BOT_TOKEN=
BOT_USERNAME=luchok_secondhand_bot
WEBHOOK_SECRET=
# 32 random bytes encoded as 64 hex characters. Keep stable across upgrades.
DATA_KEY=
# Base32 TOTP secret from a secure authenticator setup; do not put in source.
OWNER_TOTP_SECRET=
# Production startup is separately approved. Live delivery is explicitly
# required in production; use local mode + dry-run for technical acceptance.
BOT_DELIVERY_MODE=live
PORT=3000
HOST=0.0.0.0
MEDIA_DIR=/data/media
